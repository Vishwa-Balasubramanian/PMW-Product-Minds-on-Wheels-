# Server only. Never use NEXT_PUBLIC_ for these values.
# Voice co-pilot (OpenAI Realtime). The browser only receives short-lived client secrets.
OPENAI_API_KEY=
# Optional overrides.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# Optional: defaults to ../db/pmw.sqlite locally.
# PMW_DB=
# Hosted deployments use the existing Turso configuration.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
