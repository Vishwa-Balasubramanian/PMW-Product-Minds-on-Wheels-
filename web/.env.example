# Server only. Never use NEXT_PUBLIC_ for these values.
# Voice co-pilot (OpenAI Realtime). The browser only receives short-lived client secrets.
OPENAI_API_KEY=
# Without OPENAI_API_KEY the mic runs the local voice mode (browser speech recognition + PMW's command router).
# ElevenLabs speaks its replies when this key is set; otherwise the browser voice is used.
ELEVENLABS_API_KEY=
# Conversational mode (ElevenLabs agent). Create or update it with: node --env-file=.env.local scripts/eleven-agent.ts
ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# Optional overrides.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# Optional: defaults to ../db/pmw.sqlite locally.
# PMW_DB=
# Hosted deployments use the existing Turso configuration.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
